{
  "name": "lambdaflow",
  "displayName": "LambdaFlow",
  "description": "Create, configure, build, run, and debug Windows and Linux desktop apps with web frontends and any backend language.",
  "version": "1.3.1",
  "publisher": "simplelambda",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/simplelambda/LambdaFlow.git",
    "directory": "Integrations/vscode-extension"
  },
  "homepage": "https://github.com/simplelambda/LambdaFlow#readme",
  "bugs": {
    "url": "https://github.com/simplelambda/LambdaFlow/issues"
  },
  "keywords": [
    "desktop",
    "webview",
    "cross-platform",
    "backend",
    "lambdaflow",
    "webview2",
    "webkitgtk",
    "html",
    "javascript",
    "csharp",
    "python",
    "java",
    "nodejs",
    "go",
    "react",
    "vue",
    "svelte"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#F2F4F8",
    "theme": "dark"
  },
  "pricing": "Free",
  "icon": "icon.png",
  "main": "./out/extension",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "LambdaFlow projects can define backend and pre-build commands, so only trusted workspaces may be built or run."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "LambdaFlow requires local filesystem paths and native build tools."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lambdaflow-sidebar",
          "title": "LambdaFlow",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "lambdaflow-sidebar": [
        {
          "type": "webview",
          "id": "lambdaflow.sidebar",
          "name": "LambdaFlow"
        }
      ]
    },
    "commands": [
      {
        "command": "lambdaflow.newProject",
        "title": "New Project",
        "category": "LambdaFlow",
        "icon": "$(add)"
      },
      {
        "command": "lambdaflow.buildProject",
        "title": "Build",
        "category": "LambdaFlow",
        "icon": "$(gear)"
      },
      {
        "command": "lambdaflow.openConfig",
        "title": "Edit Configuration",
        "category": "LambdaFlow",
        "icon": "$(settings-gear)"
      },
      {
        "command": "lambdaflow.runProject",
        "title": "Build & Run",
        "category": "LambdaFlow",
        "icon": "$(debug-start)"
      },
      {
        "command": "lambdaflow.debugProject",
        "title": "Build & Debug",
        "category": "LambdaFlow",
        "icon": "$(debug-alt)"
      }
    ],
    "customEditors": [
      {
        "viewType": "lambdaflow.configEditor",
        "displayName": "LambdaFlow Config Editor",
        "selector": [
          {
            "filenamePattern": "config.json"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "lambdaflow.newProject"   },
        { "command": "lambdaflow.buildProject" },
        { "command": "lambdaflow.openConfig"   },
        { "command": "lambdaflow.runProject"   },
        { "command": "lambdaflow.debugProject" }
      ],
      "view/title": [
        {
          "command": "lambdaflow.runProject",
          "when": "view == lambdaflow.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "lambdaflow.debugProject",
          "when": "view == lambdaflow.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "lambdaflow.buildProject",
          "when": "view == lambdaflow.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "lambdaflow.newProject",
          "when": "view == lambdaflow.sidebar",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "LambdaFlow",
      "properties": {
        "lambdaflow.frameworkPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the LambdaFlow framework source directory.",
          "scope": "machine"
        },
        "lambdaflow.dotnetPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the .NET SDK host executable. LambdaFlow also searches DOTNET_HOST_PATH, DOTNET_ROOT, PATH, standard install locations, and ~/.dotnet.",
          "scope": "machine"
        },
        "lambdaflow.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to Node.js. Its directory is added to CLI task PATH so Node.js backends and React, Vue, or Svelte pre-build commands can find node, npm, and npx.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node ./node_modules/typescript/lib/tsc.js -p ./",
    "watch": "node ./node_modules/typescript/lib/tsc.js -watch -p ./",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.3"
  }
}
